# Nike Account Creator Configuration

# API Configuration
NIKE_API_BASE_URL=https://www.nike.com
TEMP_EMAIL_SERVICE=MailSlurp

# MailSlurp
MAILSLURP_API_KEY=

# Live mode (if true, the tool will attempt real requests to the Nike site -- use with caution)
LIVE_MODE=false

# Optional OpenAI API key for AI extraction fallback
OPENAI_API_KEY=

# Proxy (optional)
PROXY_ENABLED=false
PROXY_URL=

# Logging
DEBUG=false
LOG_LEVEL=info

# Rate Limiting
REQUEST_DELAY_MS=1000
